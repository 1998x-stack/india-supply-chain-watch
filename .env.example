# A working PostgreSQL database is required to enable community submissions.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"
# Choose a long unique password; never prefix with NEXT_PUBLIC_.
ADMIN_PASSWORD=""
SESSION_SECRET=""
# Cloudflare Turnstile: both keys are required to accept public submissions.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
# Legal/privacy contact displayed on the website.
NEXT_PUBLIC_CONTACT_EMAIL=""
# After deploying, set the canonical HTTPS URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=""
