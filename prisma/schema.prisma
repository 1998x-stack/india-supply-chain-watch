generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReportStatus {
  PENDING
  REVIEWING
  PUBLISHED
  REJECTED
  WITHDRAWN
}

enum ReportKind {
  EXPERIENCE
  CORRECTION
}

model Report {
  id           String       @id @default(cuid())
  kind         ReportKind   @default(EXPERIENCE)
  status       ReportStatus @default(PENDING)
  title        String       @db.VarChar(140)
  category     String       @db.VarChar(40)
  body         String       @db.Text
  sourceUrl    String?      @db.VarChar(1500)
  contactEmail String       @db.VarChar(254)
  ipDigest     String       @db.VarChar(64)
  consent      Boolean
  editorNote   String?      @db.Text
  publicTitle  String?      @db.VarChar(140)
  publicBody   String?      @db.Text
  publishedAt  DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([ipDigest, createdAt])
}
